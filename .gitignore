# ─── Build outputs ──────────────────────────────────────────────
build/
dist/
target/

# ─── IDE / NetBeans ─────────────────────────────────────────────
nbproject/private/
.idea/
*.iml
*.iws
*.ipr
.classpath
.project
.settings/

# ─── Compiled classes ───────────────────────────────────────────
*.class
*.jar
# Keep lib JARs that are part of the project
!web/WEB-INF/lib/*.jar

# ─── Logs ───────────────────────────────────────────────────────
*.log
logs/

# ─── 🔐 SECRETS — NEVER COMMIT THESE ───────────────────────────
# context.xml holds DB password, Razorpay keys, Gmail app password
web/META-INF/context.xml
build/web/META-INF/context.xml

# Any .properties files that may hold credentials
*.properties
!nbproject/project.properties
!nbproject/genfiles.properties

# ─── OS junk ────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ─── Temp / misc ────────────────────────────────────────────────
*.tmp
*.bak
*.swp