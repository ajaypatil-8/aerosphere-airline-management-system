<?xml version="1.0" encoding="UTF-8"?>
<!--
    AeroSphere — Tomcat Context Configuration

    All values here are FALLBACK defaults only.
    Environment variables (set in docker-compose.yml / .env) take priority.
    See AppConfig.java for the resolution order.

    For local development without Docker, edit values here.
    For production, always use environment variables — never commit secrets.
-->
<Context path="/">

    <!-- ── Database ──────────────────────────────────────────────── -->
    <!-- Overridden by: DB_URL, DB_USER, DB_PASSWORD env vars -->
    <Parameter name="db.url"
               value="jdbc:mysql://localhost:3306/airlinedb?useSSL=false&amp;serverTimezone=UTC&amp;allowPublicKeyRetrieval=true"
               override="false"/>
    <Parameter name="db.user"      value="root"  override="false"/>
    <Parameter name="db.password"  value=""      override="false"/>

    <!-- ── Razorpay ──────────────────────────────────────────────── -->
    <!-- Overridden by: RAZORPAY_KEY_ID, RAZORPAY_KEY_SECRET env vars -->
    <Parameter name="razorpay.key_id"     value="" override="false"/>
    <Parameter name="razorpay.key_secret" value="" override="false"/>

    <!-- ── SMTP ──────────────────────────────────────────────────── -->
    <!-- Overridden by: SMTP_HOST, SMTP_PORT, SMTP_USER, SMTP_PASSWORD env vars -->
    <Parameter name="smtp.host"     value="smtp.gmail.com" override="false"/>
    <Parameter name="smtp.port"     value="587"            override="false"/>
    <Parameter name="smtp.user"     value=""               override="false"/>
    <Parameter name="smtp.password" value=""               override="false"/>
    <Parameter name="smtp.from"     value="AeroSphere"     override="false"/>

    <!-- ── SMS ───────────────────────────────────────────────────── -->
    <!-- Overridden by: SMS_API_KEY env var -->
    <Parameter name="sms.api.key" value="" override="false"/>

    <!-- ── App Settings ──────────────────────────────────────────── -->
    <!-- Overridden by: APP_NAME, APP_BASE_URL env vars -->
    <Parameter name="app.name"    value="AeroSphere"        override="false"/>
    <Parameter name="app.baseUrl" value="http://localhost"  override="false"/>

</Context>
