<?xml version="1.0" encoding="UTF-8"?>
<web-app version="5.0" xmlns="https://jakarta.ee/xml/ns/jakartaee" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee          https://jakarta.ee/xml/ns/jakartaee/web-app_5_0.xsd">
    <display-name>Aerosphere Airline Management System</display-name>
    <context-param>
        <param-name>razorpay.key.id</param-name>
        <param-value>rzp_test_REPLACE_WITH_YOUR_KEY</param-value>
    </context-param>
    <context-param>
        <param-name>razorpay.key.secret</param-name>
        <param-value>REPLACE_WITH_YOUR_SECRET</param-value>
    </context-param>
    <servlet>
        <servlet-name>LoginServlet</servlet-name>
        <servlet-class>com.skyconnect.controller.LoginServlet</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>RegisterServlet</servlet-name>
        <servlet-class>com.skyconnect.controller.RegisterServlet</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>LogoutServlet</servlet-name>
        <servlet-class>com.skyconnect.controller.LogoutServlet</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>SearchFlightServlet</servlet-name>
        <servlet-class>com.skyconnect.servlet.SearchFlightServlet</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>BookFlightServlet</servlet-name>
        <servlet-class>com.skyconnect.controller.BookFlightServlet</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>AddPassengerServlet</servlet-name>
        <servlet-class>com.skyconnect.controller.AddPassengerServlet</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>CreateRazorpayOrderServlet</servlet-name>
        <servlet-class>com.skyconnect.servlet.CreateRazorpayOrderServlet</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>PaymentVerifyServlet</servlet-name>
        <servlet-class>com.skyconnect.servlet.PaymentVerifyServlet</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>UserDashboardServlet</servlet-name>
        <servlet-class>com.skyconnect.controller.UserDashboardServlet</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>UserBookingsServlet</servlet-name>
        <servlet-class>com.skyconnect.controller.UserBookingsServlet</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>CancelBookingServlet</servlet-name>
        <servlet-class>com.skyconnect.controller.CancelBookingServlet</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>ProfileServlet</servlet-name>
        <servlet-class>com.skyconnect.controller.ProfileServlet</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>UpdateProfileServlet</servlet-name>
        <servlet-class>com.skyconnect.servlet.UpdateProfileServlet</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>RefundHistoryServlet</servlet-name>
        <servlet-class>com.skyconnect.servlet.RefundHistoryServlet</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>AdminDashboardServlet</servlet-name>
        <servlet-class>com.skyconnect.controller.AdminDashboardServlet</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>AddFlightServlet</servlet-name>
        <servlet-class>com.skyconnect.controller.AddFlightServlet</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>EditFlightServlet</servlet-name>
        <servlet-class>com.skyconnect.controller.EditFlightServlet</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>DeleteFlightServlet</servlet-name>
        <servlet-class>com.skyconnect.controller.DeleteFlightServlet</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>AdminFlightsServlet</servlet-name>
        <servlet-class>com.skyconnect.controller.AdminFlightsServlet</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>AdminBookingsServlet</servlet-name>
        <servlet-class>com.skyconnect.controller.AdminBookingsServlet</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>AdminRefundsServlet</servlet-name>
        <servlet-class>com.skyconnect.controller.AdminRefundsServlet</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>ApproveRefundServlet</servlet-name>
        <servlet-class>com.skyconnect.controller.ApproveRefundServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>LoginServlet</servlet-name>
        <url-pattern>/login</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>RegisterServlet</servlet-name>
        <url-pattern>/register</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>LogoutServlet</servlet-name>
        <url-pattern>/logout</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>SearchFlightServlet</servlet-name>
        <url-pattern>/search</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>BookFlightServlet</servlet-name>
        <url-pattern>/book</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>AddPassengerServlet</servlet-name>
        <url-pattern>/addPassengers</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>CreateRazorpayOrderServlet</servlet-name>
        <url-pattern>/createOrder</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>PaymentVerifyServlet</servlet-name>
        <url-pattern>/verifyPayment</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>UserDashboardServlet</servlet-name>
        <url-pattern>/dashboard</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>UserBookingsServlet</servlet-name>
        <url-pattern>/myBookings</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>CancelBookingServlet</servlet-name>
        <url-pattern>/cancelBooking</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>ProfileServlet</servlet-name>
        <url-pattern>/profile</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>UpdateProfileServlet</servlet-name>
        <url-pattern>/updateProfile</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>RefundHistoryServlet</servlet-name>
        <url-pattern>/refundHistory</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>AdminDashboardServlet</servlet-name>
        <url-pattern>/admin/dashboard</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>AddFlightServlet</servlet-name>
        <url-pattern>/admin/addFlight</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>EditFlightServlet</servlet-name>
        <url-pattern>/admin/editFlight</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>DeleteFlightServlet</servlet-name>
        <url-pattern>/admin/deleteFlight</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>AdminFlightsServlet</servlet-name>
        <url-pattern>/admin/flights</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>AdminBookingsServlet</servlet-name>
        <url-pattern>/admin/bookings</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>AdminRefundsServlet</servlet-name>
        <url-pattern>/admin/refunds</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>ApproveRefundServlet</servlet-name>
        <url-pattern>/admin/approveRefund</url-pattern>
    </servlet-mapping>
    <session-config>
        <session-timeout>60</session-timeout>
    </session-config>
    <welcome-file-list>
        <welcome-file>index.jsp</welcome-file>
    </welcome-file-list>
    <error-page>
        <error-code>403</error-code>
        <location>/login.jsp</location>
    </error-page>
    <error-page>
        <error-code>404</error-code>
        <location>/index.jsp</location>
    </error-page>
</web-app>
