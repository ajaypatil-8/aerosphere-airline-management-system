<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee
                             http://xmlns.jcp.org/xml/ns/javaee/web-app_3_1.xsd"
         version="3.1">

    <display-name>AeroSphere Airline Booking System</display-name>

    <!-- ═══════════════════════════════════════════════════════════
         SESSION CONFIGURATION
         ═══════════════════════════════════════════════════════════ -->
    <session-config>
        <session-timeout>30</session-timeout>
        <cookie-config>
            <http-only>true</http-only>
            <secure>false</secure><!-- Change to true on HTTPS -->
            <path>/</path>
        </cookie-config>
        <tracking-mode>COOKIE</tracking-mode>
    </session-config>

    <!-- ═══════════════════════════════════════════════════════════
         WELCOME FILE
         ═══════════════════════════════════════════════════════════ -->
    <welcome-file-list>
        <welcome-file>Views/auth/index.jsp</welcome-file>
    </welcome-file-list>

    <!-- ═══════════════════════════════════════════════════════════
         STATIC PAGES — direct JSP forwards (no Java logic needed)
         ═══════════════════════════════════════════════════════════ -->

    <!-- Help Center -->
    <servlet>
        <servlet-name>HelpCenter</servlet-name>
        <jsp-file>/Views/common/help_center.jsp</jsp-file>
    </servlet>
    <servlet-mapping>
        <servlet-name>HelpCenter</servlet-name>
        <url-pattern>/help</url-pattern>
    </servlet-mapping>

    <!-- FAQs -->
    <servlet>
        <servlet-name>Faqs</servlet-name>
        <jsp-file>/Views/common/faqs.jsp</jsp-file>
    </servlet>
    <servlet-mapping>
        <servlet-name>Faqs</servlet-name>
        <url-pattern>/faqs</url-pattern>
    </servlet-mapping>

    <!-- Cancellation Policy -->
    <servlet>
        <servlet-name>CancellationPolicy</servlet-name>
        <jsp-file>/Views/common/cancellation_policy.jsp</jsp-file>
    </servlet>
    <servlet-mapping>
        <servlet-name>CancellationPolicy</servlet-name>
        <url-pattern>/cancellationPolicy</url-pattern>
    </servlet-mapping>

    <!-- Baggage Policy -->
    <servlet>
        <servlet-name>BaggagePolicy</servlet-name>
        <jsp-file>/Views/common/baggage_policy.jsp</jsp-file>
    </servlet>
    <servlet-mapping>
        <servlet-name>BaggagePolicy</servlet-name>
        <url-pattern>/baggagePolicy</url-pattern>
    </servlet-mapping>

    <!-- Privacy Policy -->
    <servlet>
        <servlet-name>PrivacyPolicy</servlet-name>
        <jsp-file>/Views/common/privacy_policy.jsp</jsp-file>
    </servlet>
    <servlet-mapping>
        <servlet-name>PrivacyPolicy</servlet-name>
        <url-pattern>/privacyPolicy</url-pattern>
    </servlet-mapping>

    <!-- Terms of Service -->
    <servlet>
        <servlet-name>TermsOfService</servlet-name>
        <jsp-file>/Views/common/terms_of_service.jsp</jsp-file>
    </servlet>
    <servlet-mapping>
        <servlet-name>TermsOfService</servlet-name>
        <url-pattern>/termsOfService</url-pattern>
    </servlet-mapping>

    <!-- Cookie Policy -->
    <servlet>
        <servlet-name>CookiePolicy</servlet-name>
        <jsp-file>/Views/common/cookie_policy.jsp</jsp-file>
    </servlet>
    <servlet-mapping>
        <servlet-name>CookiePolicy</servlet-name>
        <url-pattern>/cookiePolicy</url-pattern>
    </servlet-mapping>

    <!-- ═══════════════════════════════════════════════════════════
         ERROR PAGES
         ═══════════════════════════════════════════════════════════ -->
    <error-page>
        <error-code>404</error-code>
        <location>/Views/common/error_404.jsp</location>
    </error-page>
    <error-page>
        <error-code>403</error-code>
        <location>/Views/common/error_403.jsp</location>
    </error-page>
    <error-page>
        <error-code>500</error-code>
        <location>/Views/common/error_500.jsp</location>
    </error-page>
    <error-page>
        <exception-type>java.lang.Throwable</exception-type>
        <location>/Views/common/error_500.jsp</location>
    </error-page>

</web-app>
